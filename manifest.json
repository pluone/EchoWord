{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.3.1",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "permissions": [
    "tts",
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}